# ==============================================================================
# FTVTI ECSF Backend Production Environment Variables
# Copy these values into your Render / Railway / Cloud Dashboard
# ==============================================================================

NODE_ENV=production
PORT=10000

# Managed PostgreSQL Connection String (from Neon.tech or Supabase)
# Example: postgres://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secure 64-char randomly generated key for JWT signing
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_characters

# JWT expiration duration
JWT_EXPIRES_IN=24h

# Allowed frontend origin(s) for CORS
CORS_ORIGIN=https://ecsf-fellowship.com,https://www.ecsf-fellowship.com
